# =================================================================
# OnChain Alpha Scanner — Docker Environment Template
# =================================================================
# Copy this file to .env.docker and fill in real values.
#
#   cp .env.docker.example .env.docker
#
# .env.docker is gitignored — NEVER commit it to version control.
# =================================================================

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost
# Production example: https://scanner.coinxera.com


# ── Supabase (Authentication & Database) ─────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ── Deep Scan Provider API Keys (server-side only) ───────────────
# These are never exposed to the browser — server-side Next.js API routes only
GOLDRUSH_API_KEY=
ALCHEMY_API_KEY=
UNISWAP_API_KEY=
BITQUERY_CLIENT_ID=
BITQUERY_CLIENT_SECRET=
GOPLUS_API_KEY=
MORALIS_API_KEY=


# ── AI & Social Integration ───────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
TWITTER_BEARER_TOKEN=
GITHUB_TOKEN=


# ── Worker Config ─────────────────────────────────────────────────
WORKER_SECRET_KEY=
WALLET_ENRICHMENT_WORKER_URL=


# ── Solana Config ─────────────────────────────────────────────────
NEXT_PUBLIC_TREASURY_WALLET=YOUR_SOLANA_WALLET_ADDRESS
