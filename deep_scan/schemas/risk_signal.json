{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskSignal",
  "type": "object",
  "properties": {
    "risk_id": {
      "type": "string"
    },
    "risk_name": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "mitigated", "inactive"]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": {
      "type": "string"
    },
    "timeframe_relevance": {
      "type": "string",
      "description": "e.g., immediate execution risk, mid-term holding risk"
    }
  },
  "required": ["risk_id", "risk_name", "severity", "status", "evidence_ids", "description"]
}
