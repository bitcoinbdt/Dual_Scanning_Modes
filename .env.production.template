# Production Environment Variables for Vercel
# Copy these to Vercel Dashboard → Settings → Environment Variables

# Production Site URL
NEXT_PUBLIC_APP_URL=https://scanner.coinxera.com

# Backend API URL (from Render)
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Solana Treasury Wallet (where credit payments go)
NEXT_PUBLIC_TREASURY_WALLET=YOUR_SOLANA_WALLET_ADDRESS

# Supabase Configuration (for authentication and database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
