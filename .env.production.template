# Production Environment Variables for Vercel
# Copy these to Vercel Dashboard → Settings → Environment Variables

# Production Site URL
NEXT_PUBLIC_APP_URL=https://scanner.coinxera.com

# Backend API URL (from Render)
NEXT_PUBLIC_BACKEND_URL=https://your-backend.onrender.com

# Solana Treasury Wallet (where credit payments go)
NEXT_PUBLIC_TREASURY_WALLET=YOUR_SOLANA_WALLET_ADDRESS

# Supabase Configuration (for authentication and database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Deep Scan Provider API Keys (Server-side only, do NOT prefix with NEXT_PUBLIC_)
GOLDRUSH_API_KEY=
ALCHEMY_API_KEY=
UNISWAP_API_KEY=
BITQUERY_CLIENT_ID=
BITQUERY_CLIENT_SECRET=
GOPLUS_API_KEY=
MORALIS_API_KEY=

# Async Wallet Enrichment Worker Configuration (Phase 5C-H)
WORKER_SECRET_KEY=
WALLET_ENRICHMENT_WORKER_URL=
